{
  "name": "@blueprintjs/datetime",
  "version": "6.2.0",
  "description": "Components for interacting with dates and times",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "esnext": "lib/esnext/index.js",
  "typings": "lib/esm/index.d.ts",
  "style": "lib/css/blueprint-datetime.css",
  "files": [
    "lib",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "classnames": "^2.3.1",
    "date-fns": "^2.28.0",
    "date-fns-tz": "^2.0.0",
    "react-day-picker": "^8.10.0",
    "react-innertext": "^1.1.5",
    "tslib": "~2.6.2",
    "@blueprintjs/core": "^6.16.0",
    "@blueprintjs/icons": "^6.11.0",
    "@blueprintjs/select": "^6.3.0"
  },
  "peerDependencies": {
    "@types/react": "18 || 19",
    "react": "18 || 19",
    "react-dom": "18 || 19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "4.0.7",
    "enzyme": "^3.11.0",
    "jsdom": "^27.1.0",
    "npm-run-all": "^4.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.3",
    "vitest": "4.0.7",
    "webpack-cli": "^5.1.4",
    "@blueprintjs/node-build-scripts": "^10.0.0",
    "@blueprintjs/colors": "^5.1.16",
    "@blueprintjs/stylelint-plugin": "^5.2.3",
    "@blueprintjs/test-commons": "^4.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:palantir/blueprint.git",
    "directory": "packages/datetime"
  },
  "keywords": [
    "palantir",
    "blueprint",
    "theme",
    "react",
    "day",
    "picker",
    "date",
    "time"
  ],
  "author": "Palantir Technologies",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf coverage lib",
    "compile": "run-p \"compile:*\"",
    "compile:esm": "tsc -p ./src/tsconfig.build.json",
    "compile:cjs": "tsc -p ./src/tsconfig.build.json -m commonjs --verbatimModuleSyntax false --outDir lib/cjs",
    "compile:esnext": "tsc -p ./src/tsconfig.build.json -t esnext --outDir lib/esnext",
    "compile:css": "sass-compile ./src",
    "dev": "run-p \"compile:esm --watch\" \"compile:css --watch\"",
    "dist": "run-s \"dist:*\"",
    "dist:css": "css-dist lib/css",
    "dist:verify": "assert-package-layout",
    "lint": "run-p lint:scss lint:es",
    "lint:scss": "sass-lint",
    "lint:es": "es-lint",
    "lint-fix": "es-lint --fix && sass-lint --fix",
    "test": "run-s test:typeCheck test:iso test:vitest:run",
    "test:typeCheck": "tsc -p ./src/tsconfig.test.json",
    "test:iso": "vitest run --config vitest.config.isotest.mts",
    "test:vitest": "vitest",
    "test:vitest:run": "vitest run",
    "verify": "npm-run-all compile -p dist test lint"
  }
}